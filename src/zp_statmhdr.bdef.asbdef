projection;
strict ( 2 ); //Uncomment this line in order to enable strict mode 2. The strict mode has two variants (strict(1), strict(2)) and is prerequisite to be future proof regarding syntax and to be able to release your BO.

define behavior for ZP_STATMHDR alias StatementHeader
use etag
{
  use create;
  use update;
  use delete;

  use association _StatementEvent { create; }
}

define behavior for ZP_STATMEVENT alias StatementEvent
{
  use update;
  use delete;

  use association _StatementHeader;
}